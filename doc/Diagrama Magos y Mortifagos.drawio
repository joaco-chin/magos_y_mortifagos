<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="sXe2Swe6SICSBWwFjfDP">
    <mxGraphModel dx="2945" dy="1919" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\n&#39; --- INTERFACES Y CLASES ABSTRACTAS PRINCIPALES ---\n\nabstract class Personaje {\n  # nombre: String\n  # nivelMagia: int\n  # puntosVida: double\n  # maxPuntosVida: double\n  # hechizosConocidos: List&lt;Hechizo&gt;\n  # estado: EfectoEstado\n  # observer: BatallaObserver\n  # batalla: GestorBatalla\n  + lanzarHechizo(hechizo: Hechizo, objetivo: Personaje)\n  + usarItem(item: Item, objetivo: Personaje)\n  + recibirDaño(cantidad: double)\n  + curarse(cantidad: double)\n  + cambiarEstado(estado: EfectoEstado)\n  {abstract} # notificarDerrota()\n  + aplicarEfectosDeTurno()\n}\n\nabstract class Mago\nabstract class Mortifago\n\nPersonaje &lt;|-- Mago\nPersonaje &lt;|-- Mortifago\n\n&#39; --- CLASES CONCRETAS DE PERSONAJES ---\n\nclass Auror\nclass Estudiante\nclass Profesor\n\nMago &lt;|-- Auror\nMago &lt;|-- Estudiante\nMago &lt;|-- Profesor\n\nclass Comandante\nclass SeguidorComun\n\nMortifago &lt;|-- Comandante\nMortifago &lt;|-- SeguidorComun\n\n&#39; --- SISTEMA DE ESTADOS (STATE PATTERN) ---\n\nabstract class EfectoEstado {\n  # personaje: Personaje\n  {abstract} + lanzarHechizo(hechizo: Hechizo, objetivo: Personaje)\n  {abstract} + usarItem(item: Item, objetivo: Personaje)\n  {abstract} + recibirDaño(cantidad: double)\n  {abstract} + curarse(cantidad: double)\n  + actualizar()\n}\n\nclass EstadoNormal\nclass EstadoDerrotado\n\nabstract class EfectoDurable {\n  # duracionTurnos: int\n  + actualizar()\n}\n\nEfectoEstado &lt;|-- EstadoNormal\nEfectoEstado &lt;|-- EstadoDerrotado\nEstadoNormal &lt;|-- EfectoDurable\n\nclass EstadoCongelado\nclass EstadoDebilidad\nclass EstadoResistencia\nclass EstadoVeneno\n\nEfectoDurable &lt;|-- EstadoCongelado\nEfectoDurable &lt;|-- EstadoDebilidad\nEfectoDurable &lt;|-- EstadoResistencia\nEfectoDurable &lt;|-- EstadoVeneno\n\nPersonaje \&quot;1\&quot; *-- \&quot;1\&quot; EfectoEstado : tiene &gt;\n\n&#39; --- SISTEMA DE HECHIZOS (STRATEGY PATTERN) ---\n\ninterface Hechizo {\n  + ejecutar(objetivo: Personaje)\n}\n\nclass AvadaKedavra\nclass Desmaius\nclass ExpectoPatronum\nclass Expelliarmus\nclass PetrificusTotalus\nclass Protego\n\nHechizo &lt;|.. AvadaKedavra\nHechizo &lt;|.. Desmaius\nHechizo &lt;|.. ExpectoPatronum\nHechizo &lt;|.. Expelliarmus\nHechizo &lt;|.. PetrificusTotalus\nHechizo &lt;|.. Protego\n\nPersonaje \&quot;1\&quot; o-- \&quot;*\&quot; Hechizo : conoce &gt;\n\n&#39; --- FACTORIAS Y RECLUTAMIENTO ---\n\nclass Reclutador {\n  + {static} crearMago(tipo: String, batalla: GestorBatalla): Mago\n  + {static} crearMortifago(tipo: String, batalla: GestorBatalla): Mortifago\n}\n\ninterface MagoFactory {\n  + crearMago(batalla: GestorBatalla): Mago\n}\ninterface MortifagoFactory {\n  + crearMortifago(batalla: GestorBatalla): Mortifago\n}\n\nclass HechizoFactory {\n  + {static} crearHechizo(tipo: String, nivel: double): Hechizo\n}\n\nReclutador ..&gt; MagoFactory : usa\nReclutador ..&gt; MortifagoFactory : usa\n\n&#39; --- SISTEMA DE BATALLA Y OBSERVER ---\n\ninterface BatallaObserver {\n  + onPersonajeDerrotado(personaje: Personaje)\n  + onHechizoLanzado(lanzador: Personaje, hechizo: Hechizo, objetivo: Personaje)\n}\n\nclass Batallon {\n  - miembros: List&lt;Personaje&gt;\n  + agregarMiembro(personaje: Personaje)\n  + obtenerPersonajesVivos(): List&lt;Personaje&gt;\n}\n\nBatallaObserver &lt;|.. Batallon\n\nclass LogBatalla {\n  - secuenciaAtaques: List&lt;String&gt;\n  + mostrarHistorial()\n}\n\nBatallaObserver &lt;|.. LogBatalla\n\nclass GestorBatalla {\n  - bandoMagos: Batallon\n  - bandoMortifagos: Batallon\n  - logEventos: LogBatalla\n  - observers: List&lt;BatallaObserver&gt;\n  + iniciarBatalla()\n  + gestionarTurno(turnoActual: Personaje)\n}\n\nGestorBatalla *-- Batallon : administra &gt;\nGestorBatalla *-- LogBatalla : registra &gt;\nPersonaje ..&gt; BatallaObserver : notifica &gt;\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="wAaiAUUl0doYJhaUq2GW-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="916" width="3454" x="-960" y="-190" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
