<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="sXe2Swe6SICSBWwFjfDP">
    <mxGraphModel dx="3113" dy="2047" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\nskinparam classAttributeIconSize 0\n\n&#39;==========================\n&#39; PERSONAJES\n&#39;==========================\n\nabstract class Personaje{\n    #nombre : String\n    #nivelMagia : int\n    #puntosVida : double\n    #maxPuntosVida : double\n    #hechizosConocidos : List&lt;Hechizo&gt;\n    #estado : EfectoEstado\n    -inventario : List&lt;Object&gt;\n    #batalla : GestorBatalla\n    #bando : Batallon\n\n    +lanzarHechizo(h:Hechizo,obj:Personaje)\n    +recibirDaño(c:double)\n    +curarse(c:double)\n    +cambiarEstado(e:EfectoEstado)\n    +equiparItem(item:Object)\n    +usarItem(nombre:String,obj:Personaje)\n    +aplicarEfectosDeTurno()\n    +setBando(b:Batallon)\n    +getBando():Batallon\n    +esDelMismoBando(p:Personaje):boolean\n}\n\nabstract class Mago\nabstract class Mortifago\n\nPersonaje &lt;|-- Mago\nPersonaje &lt;|-- Mortifago\n\nclass Auror\nclass Profesor\nclass Estudiante\n\nMago &lt;|-- Auror\nMago &lt;|-- Profesor\nMago &lt;|-- Estudiante\n\nclass Comandante{\n    -furia:boolean\n}\n\nclass SeguidorComun\n\nMortifago &lt;|-- Comandante\nMortifago &lt;|-- SeguidorComun\n\n&#39;==========================\n&#39; ESTADOS (STATE)\n&#39;==========================\n\nabstract class EfectoEstado{\n    #personaje:Personaje\n    +lanzarHechizo(h,obj)\n    +recibirDaño(c)\n    +curarse(c)\n    +actualizar()\n}\n\nclass EstadoNormal\nclass EstadoDerrotado\n\nabstract class EfectoDurable{\n    #duracionTurnos:int\n    +actualizar()\n}\n\nclass EstadoCongelado\nclass EstadoDebilidad\nclass EstadoResistencia\nclass EstadoVeneno\n\nEfectoEstado &lt;|-- EstadoNormal\nEfectoEstado &lt;|-- EstadoDerrotado\nEstadoNormal &lt;|-- EfectoDurable\n\nEfectoDurable &lt;|-- EstadoCongelado\nEfectoDurable &lt;|-- EstadoDebilidad\nEfectoDurable &lt;|-- EstadoResistencia\nEfectoDurable &lt;|-- EstadoVeneno\n\nPersonaje *-- EfectoEstado\n\n&#39;==========================\n&#39; HECHIZOS (STRATEGY)\n&#39;==========================\n\ninterface Hechizo{\n    +ejecutar(objetivo:Personaje)\n}\n\nclass Expelliarmus\nclass AvadaKedavra\nclass Desmaius\nclass PetrificusTotalus\nclass Protego\nclass ExpectoPatronum\n\nHechizo &lt;|.. Expelliarmus\nHechizo &lt;|.. AvadaKedavra\nHechizo &lt;|.. Desmaius\nHechizo &lt;|.. PetrificusTotalus\nHechizo &lt;|.. Protego\nHechizo &lt;|.. ExpectoPatronum\n\nPersonaje o-- Hechizo\n\nclass HechizoFactory\n\nHechizoFactory ..&gt; Hechizo\n\n&#39;==========================\n&#39; OBJETOS MAGICOS\n&#39;==========================\n\nclass PiedraFilosofal{\n    +usar(usuario,obj)\n}\n\nclass CapaInvisibilidad{\n    +esquivar():boolean\n}\n\nPersonaje o-- PiedraFilosofal\nPersonaje o-- CapaInvisibilidad\n\n&#39;==========================\n&#39; FACTORY METHOD\n&#39;==========================\n\nclass Reclutador\n\ninterface MagoFactory{\n    +crearMago(nombre,batalla)\n}\n\ninterface MortifagoFactory{\n    +crearMortifago(nombre,batalla)\n}\n\nclass AurorFactory\nclass ProfesorFactory\nclass EstudianteFactory\n\nclass ComandanteFactory\nclass SeguidorComunFactory\n\nMagoFactory &lt;|.. AurorFactory\nMagoFactory &lt;|.. ProfesorFactory\nMagoFactory &lt;|.. EstudianteFactory\n\nMortifagoFactory &lt;|.. ComandanteFactory\nMortifagoFactory &lt;|.. SeguidorComunFactory\n\nclass ClasesMagos &lt;&lt;enumeration&gt;&gt;\nclass ClasesMortifagos &lt;&lt;enumeration&gt;&gt;\n\nReclutador ..&gt; ClasesMagos\nReclutador ..&gt; ClasesMortifagos\n\nClasesMagos --&gt; MagoFactory\nClasesMortifagos --&gt; MortifagoFactory\n\n&#39;==========================\n&#39; OBSERVER\n&#39;==========================\n\ninterface BatallaObserver{\n    +onPersonajeDerrotado(p)\n    +onHechizoLanzado(l,h,o)\n}\n\nclass Batallon{\n    -miembros:List&lt;Personaje&gt;\n    +agregarMiembro()\n    +obtenerPersonajesVivos()\n    +obtenerMuertos()\n    +reincorporar()\n}\n\nclass LogBatalla\n\nBatallaObserver &lt;|.. Batallon\nBatallaObserver &lt;|.. LogBatalla\nBatallaObserver &lt;|.. Comandante\n\n&#39;==========================\n&#39; GESTOR BATALLA\n&#39;==========================\n\nclass GestorBatalla{\n    -bandoMagos:Batallon\n    -bandoMortifagos:Batallon\n    -historialMagia:Map&lt;Personaje,List&lt;Hechizo&gt;&gt;\n    -hechizosUsadosEnTurno:Set&lt;String&gt;\n    -observers:List&lt;BatallaObserver&gt;\n\n    +iniciarBatalla()\n    +gestionarTurno(p)\n    +notificarPersonajeDerrotado(p)\n    +notificarHechizoLanzado(l,h,o)\n    +agregarObserver(obs)\n}\n\nGestorBatalla *-- Batallon\nGestorBatalla o-- BatallaObserver\n\nPersonaje --&gt; GestorBatalla\nPersonaje --&gt; Batallon\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="Id0IxJMa77SQ7_Hh7aoJ-2">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="1034" width="2882" x="530" y="990" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
